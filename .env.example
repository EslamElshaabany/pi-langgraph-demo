# Copy to .env and fill in whichever provider(s) you actually have a key for.
# .env is git-ignored - never commit real keys.
#
# Everything in this repo was run against Anthropic; that's the recommended
# one to fill in first. See README.md for setup details.

ANTHROPIC_API_KEY=

# Optional - only needed if you point a script at these providers instead.
# GEMINI_API_KEY hit an SSE-through-proxy issue in the original spike sandbox
# (see FINDINGS.md header) - that's an environment detail, not a code issue,
# but don't be surprised if you hit the same thing in a similarly locked-down
# environment.
GEMINI_API_KEY=
OPENCODE_API_KEY=
